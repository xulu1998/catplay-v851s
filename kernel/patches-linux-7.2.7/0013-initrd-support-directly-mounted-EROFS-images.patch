diff --git a/init/initrd_blk.c b/init/initrd_blk.c
new file mode 100644
index 000000000000..72d49c844488
--- /dev/null
+++ b/init/initrd_blk.c
@@ -0,0 +1,241 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/module.h>
+#include <linux/blkdev.h>
+#include <linux/initrd.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/uaccess.h>
+#include <linux/dax.h>
+#include <linux/pfn.h>
+#include <linux/major.h>
+
+
+struct initrd_device {
+	struct gendisk *disk;
+    struct dax_device *dax;
+    void* start;
+	phys_addr_t size; /* in bytes */
+};
+
+static struct initrd_device *initrd_dev = NULL;
+
+static void initrd_submit_bio(struct bio *bio)
+{
+    struct initrd_device *dev = bio->bi_bdev->bd_disk->private_data;
+    sector_t sector = bio->bi_iter.bi_sector;
+    struct bio_vec bvec;
+    struct bvec_iter iter;
+
+    if (!initrd_start) {
+        pr_err("initrd_blk: initrd memory was freed after initialization. This is a bug!");
+        bio_io_error(bio);
+        return;
+    }
+
+    bio_for_each_segment(bvec, bio, iter) {
+        void *mem;
+        struct page *page = bvec.bv_page;
+        unsigned int len = bvec.bv_len;
+        phys_addr_t offset = (sector << SECTOR_SHIFT);
+
+        if (offset + len > dev->size) {
+            bio_io_error(bio);
+            return;
+        }
+
+        mem = kmap_local_page(bvec.bv_page) + bvec.bv_offset;
+
+        if (!op_is_write(bio->bi_opf)) {
+            pr_debug("initrd_blk: responding to read request at offset %pa", &offset);
+            memcpy(mem, (void *)(initrd_start + offset), len);
+            flush_dcache_page(page);
+        } else {
+            pr_debug("initrd_blk: responding to write request at offset %pa", &offset);
+            flush_dcache_page(page);
+            memcpy((void *)(initrd_start + offset), mem, len);
+        }
+
+        kunmap_local(mem);
+        sector += len >> SECTOR_SHIFT;
+    }
+
+    bio_endio(bio);
+}
+
+static const struct block_device_operations initrd_fops = {
+	.owner = THIS_MODULE,
+	.submit_bio = initrd_submit_bio,
+};
+
+#ifdef CONFIG_DAX
+static long initrd_dax_direct_access(struct dax_device *dax_dev,
+				     pgoff_t pgoff, long nr_pages,
+                     enum dax_access_mode mode,
+				     void **kaddr, unsigned long *pfn)
+{
+	unsigned long offset = pgoff << PAGE_SHIFT;
+	if (offset + (nr_pages << PAGE_SHIFT) > initrd_dev->size)
+		return -ERANGE;
+
+    if (!initrd_start) {
+        pr_err("initrd_blk: initrd memory was freed after initialization. This is a bug!");
+        return -ENODEV;
+    }
+
+    pr_debug("initrd_blk: responding to DAX request at offset %llu", offset);
+
+	*kaddr = (void *)(initrd_start + offset);
+    *pfn = PHYS_PFN(__pa(initrd_start + offset));
+	return nr_pages;
+}
+
+static int initrd_dax_zero_page_range(struct dax_device *dax_dev,
+                                      pgoff_t pgoff, size_t size)
+{
+    return -EOPNOTSUPP;
+}
+
+static const struct dax_operations initrd_dax_ops = {
+	.direct_access = initrd_dax_direct_access,
+    .zero_page_range = initrd_dax_zero_page_range,
+};
+#endif
+
+static int __init initrd_blk_init(void)
+{
+	struct gendisk *disk;
+	struct queue_limits lim = {
+		.physical_block_size = PAGE_SIZE,
+		.features            = BLK_FEAT_SYNCHRONOUS |
+		                       BLK_FEAT_NOWAIT |
+		                       BLK_FEAT_DAX,
+	};
+	phys_addr_t size;
+	int err;
+
+	err = register_blkdev(INITRD_MAJOR, "initrd");
+	if (err) {
+		pr_err("initrd_blk: failed to register block major %d: %d\n",
+		       INITRD_MAJOR, err);
+		return err;
+	}
+
+	if (!initrd_start || !initrd_end) {
+		pr_err("initrd_blk: no initrd found\n");
+		err = -ENODEV;
+		goto out_unregister_blkdev;
+	}
+
+	if (initrd_start & (PAGE_SIZE - 1)) {
+		pr_err("initrd_blk: initrd provided at address not aligned to page size: %#lx\n",
+		       (unsigned long)initrd_start);
+		err = -EINVAL;
+		goto out_unregister_blkdev;
+	}
+
+	size = initrd_end - initrd_start;
+
+	if (size & (PAGE_SIZE - 1)) {
+		pr_err("initrd_blk: initrd size not aligned to page size: %pa (0x%llx)\n",
+		       &size, (unsigned long long)size);
+		err = -EINVAL;
+		goto out_unregister_blkdev;
+	}
+
+	initrd_dev = kzalloc(sizeof(*initrd_dev), GFP_KERNEL);
+	if (!initrd_dev) {
+		err = -ENOMEM;
+		goto out_unregister_blkdev;
+	}
+
+	initrd_dev->size  = size;
+	initrd_dev->start = (void *)initrd_start;
+
+	disk = blk_alloc_disk(&lim, NUMA_NO_NODE);
+	if (IS_ERR(disk)) {
+		err = PTR_ERR(disk);
+		goto out_free_dev;
+	}
+
+	initrd_dev->disk = disk;
+	disk->major        = INITRD_MAJOR;
+	disk->first_minor  = 0;
+	disk->minors       = 1;
+	disk->fops         = &initrd_fops;
+	disk->private_data = initrd_dev;
+	strscpy(disk->disk_name, "initrd", DISK_NAME_LEN);
+
+#ifdef CONFIG_DAX
+	initrd_dev->dax = alloc_dax(initrd_dev, &initrd_dax_ops);
+	if (IS_ERR(initrd_dev->dax)) {
+		err = PTR_ERR(initrd_dev->dax);
+		goto out_put_disk;
+	}
+
+	err = dax_add_host(initrd_dev->dax, disk);
+	if (err) {
+		put_dax(initrd_dev->dax);
+		goto out_put_disk;
+	}
+#endif
+
+	set_capacity(disk, size >> SECTOR_SHIFT);
+
+	err = add_disk(disk);
+	if (err)
+		goto out_dax_cleanup;
+
+#ifdef CONFIG_DAX
+	pr_info("initrd_blk: registered /dev/initrd size=%llu KB with DAX\n",
+		(unsigned long long)(size >> 10));
+#else
+	pr_info("initrd_blk: registered /dev/initrd size=%llu KB\n",
+		(unsigned long long)(size >> 10));
+#endif
+	return 0;
+
+out_dax_cleanup:
+#ifdef CONFIG_DAX
+	dax_remove_host(disk);
+	put_dax(initrd_dev->dax);
+#endif
+out_put_disk:
+	put_disk(disk);
+out_free_dev:
+	kfree(initrd_dev);
+	initrd_dev = NULL;
+out_unregister_blkdev:
+	unregister_blkdev(INITRD_MAJOR, "initrd");
+	return err;
+}
+
+static void __exit initrd_blk_exit(void)
+{
+	if (!initrd_dev)
+		return;
+
+	if (initrd_dev->disk) {
+		del_gendisk(initrd_dev->disk);
+#ifdef CONFIG_DAX
+		if (initrd_dev->dax) {
+			dax_remove_host(initrd_dev->disk);
+			put_dax(initrd_dev->dax);
+		}
+#endif
+		put_disk(initrd_dev->disk);
+	}
+
+	kfree(initrd_dev);
+	initrd_dev = NULL;
+	unregister_blkdev(INITRD_MAJOR, "initrd");
+
+	pr_info("initrd_blk: unloaded\n");
+}
+
+module_init(initrd_blk_init);
+module_exit(initrd_blk_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Initrd-backed block device");
+MODULE_ALIAS_BLOCKDEV_MAJOR(INITRD_MAJOR);
+MODULE_ALIAS("initrd");
