 			goto restore_device;
-		}
 		break;
 
 	case USB_ROLE_DEVICE:
@@ -313,7 +519,7 @@ static int sunxi_musb_role_switch_set(struct usb_role_switch *sw,
 		mode = PHY_MODE_USB_OTG;
 remove_host:
 		sunxi_musb_remove_host_controllers(glue);
-		ret = phy_set_mode(glue->phy, mode);
+		ret = sunxi_musb_acquire_device_resources(glue, mode);
 		if (ret)
 			goto out;
