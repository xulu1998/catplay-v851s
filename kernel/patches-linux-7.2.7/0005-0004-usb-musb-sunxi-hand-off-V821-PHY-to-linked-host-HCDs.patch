 error_otg_reset_assert:
 	reset_control_assert(glue->rst_otg);
 	if (test_bit(SUNXI_MUSB_FL_HAS_RESET, &glue->flags))
@@ -470,12 +686,19 @@ static int sunxi_musb_exit(struct musb *musb)
 	}
 
 	cancel_work_sync(&glue->work);
-	if (test_bit(SUNXI_MUSB_FL_PHY_ON, &glue->flags))
+	if (glue->phy_initialized &&
