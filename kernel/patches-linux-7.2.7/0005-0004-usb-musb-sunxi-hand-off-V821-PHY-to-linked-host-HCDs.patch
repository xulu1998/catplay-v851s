@@ -327,7 +533,8 @@ remove_host:
 	goto out;
 
 restore_device:
-	phy_set_mode(glue->phy, PHY_MODE_USB_DEVICE);
+	if (sunxi_musb_acquire_device_resources(glue, PHY_MODE_USB_DEVICE))
+		dev_err(glue->dev, "failed to restore device-side USB resources\n");
 out:
 	mutex_unlock(&glue->role_lock);
 	return ret;
@@ -409,6 +616,8 @@ static int sunxi_musb_init(struct musb *musb)
 	ret = reset_control_deassert(glue->rst_usb);
