+static void sunxi_musb_put_host_controller(struct platform_device *pdev)
+{
+	of_node_clear_flag(pdev->dev.of_node, OF_POPULATED);
+	platform_device_put(pdev);
+}
+
+static int sunxi_musb_add_host_controllers(struct sunxi_glue *glue)
+{
+	struct platform_device *ehci, *ohci;
+	struct device_link *link;
+	int ret;
+
+	ehci = sunxi_musb_alloc_host_controller(glue, "generic-ehci");
+	if (IS_ERR(ehci))
+		return PTR_ERR(ehci);
+
+	ohci = sunxi_musb_alloc_host_controller(glue, "generic-ohci");
+	if (IS_ERR(ohci)) {
+		ret = PTR_ERR(ohci);
+		sunxi_musb_put_host_controller(ehci);
+		return ret;
+	}
+
+	ret = of_device_add(ehci);
+	if (ret)
+		goto err_put_both;
+
+	/* OHCI must not probe until EHCI has completed usb_add_hcd(). */
+	link = device_link_add(&ohci->dev, &ehci->dev,
+			       DL_FLAG_AUTOPROBE_CONSUMER);
+	if (!link) {
+		ret = -ENOMEM;
+		goto err_unregister_ehci;
+	}
+
+	ret = of_device_add(ohci);
+	if (ret) {
+		device_link_del(link);
+		goto err_unregister_ehci;
+	}
+
+	glue->ehci_pdev = ehci;
+	glue->ohci_pdev = ohci;
+	return 0;
+
+err_unregister_ehci:
+	of_platform_device_destroy(&ehci->dev, NULL);
+	sunxi_musb_put_host_controller(ohci);
+	return ret;
+
+err_put_both:
+	sunxi_musb_put_host_controller(ohci);
+	sunxi_musb_put_host_controller(ehci);
+	return ret;
+}
+
+static void sunxi_musb_quiesce_device(struct sunxi_glue *glue)
+{
+	struct musb *musb = glue->musb;
+	unsigned long flags;
+	u8 devctl, power;
+
+	if (!musb)
+		return;
+
+	spin_lock_irqsave(&musb->lock, flags);
+	power = readb(musb->mregs + SUNXI_MUSB_POWER);
+	writeb(power & ~MUSB_POWER_SOFTCONN,
+	       musb->mregs + SUNXI_MUSB_POWER);
+	devctl = readb(musb->mregs + SUNXI_MUSB_DEVCTL);
+	writeb(devctl & ~MUSB_DEVCTL_SESSION,
+	       musb->mregs + SUNXI_MUSB_DEVCTL);
+	musb->xceiv->otg->state = OTG_STATE_B_IDLE;
+	MUSB_DEV_MODE(musb);
+	spin_unlock_irqrestore(&musb->lock, flags);
+}
+
+static void sunxi_musb_resume_device(struct sunxi_glue *glue)
+{
+	struct musb *musb = glue->musb;
+	unsigned long flags;
+	u8 devctl;
+
+	if (!musb)
+		return;
+
+	spin_lock_irqsave(&musb->lock, flags);
+	MUSB_DEV_MODE(musb);
+	musb->xceiv->otg->state = OTG_STATE_B_IDLE;
+	devctl = readb(musb->mregs + SUNXI_MUSB_DEVCTL);
+	writeb(devctl | MUSB_DEVCTL_SESSION,
+	       musb->mregs + SUNXI_MUSB_DEVCTL);
+	spin_unlock_irqrestore(&musb->lock, flags);
+}
+
+static int sunxi_musb_release_device_resources(struct sunxi_glue *glue)
+{
+	bool phy_was_on;
+	int ret;
+
+	if (!glue->phy_initialized)
+		return 0;
+
+	sunxi_musb_quiesce_device(glue);
+
+	ret = phy_set_mode(glue->phy, PHY_MODE_USB_HOST);
+	if (ret) {
+		sunxi_musb_resume_device(glue);
+		return ret;
+	}
+
+	WRITE_ONCE(glue->phy_initialized, false);
+	cancel_work_sync(&glue->work);
+	clear_bit(SUNXI_MUSB_FL_HOSTMODE, &glue->flags);
+	clear_bit(SUNXI_MUSB_FL_HOSTMODE_PEND, &glue->flags);
+	clear_bit(SUNXI_MUSB_FL_PHY_MODE_PEND, &glue->flags);
+	clear_bit(SUNXI_MUSB_FL_VBUS_ON, &glue->flags);
+
+	phy_was_on = test_and_clear_bit(SUNXI_MUSB_FL_PHY_ON, &glue->flags);
+	if (phy_was_on) {
+		ret = phy_power_off(glue->phy);
+		if (ret) {
+			set_bit(SUNXI_MUSB_FL_PHY_ON, &glue->flags);
+			goto err_restore_initialized;
+		}
+	}
+
+	ret = phy_exit(glue->phy);
+	if (ret) {
+		if (phy_was_on && !phy_power_on(glue->phy))
+			set_bit(SUNXI_MUSB_FL_PHY_ON, &glue->flags);
+		goto err_restore_initialized;
+	}
+
+	if (glue->rst_usb && glue->usb_reset_deasserted) {
+		ret = reset_control_assert(glue->rst_usb);
+		if (ret)
+			goto err_reinit_phy;
+		glue->usb_reset_deasserted = false;
+	}
+
+	return 0;
+
+err_reinit_phy:
+	if (!phy_init(glue->phy)) {
+		if (phy_was_on && !phy_power_on(glue->phy))
+			set_bit(SUNXI_MUSB_FL_PHY_ON, &glue->flags);
+		WRITE_ONCE(glue->phy_initialized, true);
+	}
+	return ret;
+
+err_restore_initialized:
+	WRITE_ONCE(glue->phy_initialized, true);
+	return ret;
+}
+
+static int sunxi_musb_acquire_device_resources(struct sunxi_glue *glue,
+					       enum phy_mode mode)
+{
+	int ret;
+
+	if (glue->rst_usb && !glue->usb_reset_deasserted) {
+		ret = reset_control_deassert(glue->rst_usb);
+		if (ret)
+			return ret;
+		glue->usb_reset_deasserted = true;
+	}
+
+	if (!glue->phy_initialized) {
+		ret = phy_init(glue->phy);
+		if (ret)
+			goto err_assert_usb_reset;
+		WRITE_ONCE(glue->phy_initialized, true);
+	}
+
+	ret = phy_set_mode(glue->phy, mode);
+	if (ret)
+		goto err_exit_phy;
+
+	glue->phy_mode = mode;
+	if (mode == PHY_MODE_USB_DEVICE) {
+		set_bit(SUNXI_MUSB_FL_VBUS_ON, &glue->flags);
+		sunxi_musb_resume_device(glue);
+	} else {
+		clear_bit(SUNXI_MUSB_FL_VBUS_ON, &glue->flags);
+	}
+	schedule_work(&glue->work);
+	return 0;
+
+err_exit_phy:
+	WRITE_ONCE(glue->phy_initialized, false);
+	phy_exit(glue->phy);
+err_assert_usb_reset:
+	if (glue->rst_usb && glue->usb_reset_deasserted) {
+		reset_control_assert(glue->rst_usb);
+		glue->usb_reset_deasserted = false;
+	}
+	return ret;
+}
