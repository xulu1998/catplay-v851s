index 927b8f8..89f1045 100644
--- a/core/rtw_ap.c
+++ b/core/rtw_ap.c
@@ -131,8 +131,10 @@ static void update_BCNTIM(_adapter *padapter)
 			if (p !=  NULL)
 				offset += tmp_len + 2;
 
-			/*DS Parameter Set IE, len=3*/
-			offset += 3;
+			/* DS Parameter Set IE: hostapd omits it on 5 GHz */
+			p = rtw_get_ie(pie + _BEACON_IE_OFFSET_, _DSSET_IE_, &tmp_len, (pnetwork_mlmeext->IELength - _BEACON_IE_OFFSET_));
+			if (p != NULL)
+				offset += tmp_len + 2;
 
 			premainder_ie = pie + offset;
 
