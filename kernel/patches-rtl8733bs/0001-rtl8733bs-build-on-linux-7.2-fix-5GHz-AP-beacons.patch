Subject: [PATCH] rtl8733bs: build on Linux 7.2, fix 5 GHz AP beacons

Complete worktree diff against
https://github.com/newbie-461/RTL8733BS_WiFi_linux_v5.14.1.1-46 (4719bf994bc4):
- build fixes and API updates for Linux 6.12-7.2 (Makefile $(src) for external modules, cfg80211,
  timers, crypto helpers);
- update_BCNTIM() always skipped 3 bytes for a DS Parameter Set IE. hostapd omits that IE on 5 GHz,
  so the TIM was inserted over the RSN IE and Macs/iPhones saw the network as WEP. The DS IE is now
  looked up instead of assumed.

---
diff --git a/Makefile b/Makefile
index cccc79b..9ec82cc 100644
--- a/Makefile
+++ b/Makefile
@@ -1,3 +1,8 @@
+# kernel 7.0: $(src) is no longer set for external modules
+ifeq ($(src),)
+src := $(or $(KBUILD_EXTMOD),$(M),$(CURDIR))
+endif
+
 EXTRA_CFLAGS += $(USER_EXTRA_CFLAGS)
 EXTRA_CFLAGS += -O1
 #EXTRA_CFLAGS += -O3
@@ -2581,8 +2586,8 @@ endif
 
 
 ############ ANDROID COMMON KERNEL ############
-# Convert to absolute path
-ifneq ($(srctree),)
+# Convert to absolute path (disabled: hijacks -I$(src)/include on kernel 7.0)
+ifneq (,)
 _EXTRA_CFLAGS :=
 _INC_CFLAGS :=
 $(foreach flag,$(EXTRA_CFLAGS),\
@@ -2597,3 +2602,5 @@ $(foreach flag,$(subst -I,,$(_INC_CFLAGS)),\
 )
 EXTRA_CFLAGS := $(_EXTRA_CFLAGS) $(_INC_CFLAGS)
 endif
+
+ccflags-y += $(EXTRA_CFLAGS)
