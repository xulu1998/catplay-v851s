#!/bin/sh
# Restart hostapd and catplay with the saved settings. The phone loses the box Wi-Fi for a few seconds.
MODE=bench; for a in $(cat /proc/cmdline); do case "$a" in u5a.mode=*) MODE=${a#u5a.mode=} ;; esac; done
echo "Content-Type: application/json"
echo
echo '{"ok":true}'
( sleep 2; u5a-settings apply "$MODE" ) </dev/null >/dev/null 2>&1 &
